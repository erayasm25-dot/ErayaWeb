# ERAYA Production Environment Variables
# Never commit .env.local to GitHub. Configure these in your hosting dashboard.

# Public site URL (e.g. https://eraya-handmade.onrender.com or https://eraya.in)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Official ERAYA contact email (leave blank until ready)
NEXT_PUBLIC_CONTACT_EMAIL=

# Production PostgreSQL connection string (required in production)
# Example: postgresql://user:password@host:5432/eraya?sslmode=require
DATABASE_URL=

# Owner Admin Dashboard password (min 12 chars in production, never prefix with NEXT_PUBLIC_)
ADMIN_PASSWORD=

# Random 32+ character secret for signing admin session cookies
ADMIN_SESSION_SECRET=

# Google Apps Script Web App URL for automated Google Sheets sync
# (Can also be configured in Owner Dashboard -> Settings)
GOOGLE_SHEETS_WEBHOOK_URL=

# Shared secret token verified by Google Apps Script
GOOGLE_SHEETS_SECRET=change-this-sheets-secret
