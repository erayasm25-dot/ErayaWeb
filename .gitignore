# ============================================================================
# ERAYA — Security-Focused .gitignore
# Protects secrets, customer data, databases, backups, keys, and build files.
# ============================================================================

# --- Environment files & secrets ---
.env
.env.*
!.env.example
*.secret
.secrets/

# --- Credentials, service accounts & private keys ---
credentials.json
*service-account*.json
*service_account*.json
serviceAccount*.json
google-credentials*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.der

# --- Databases, journals & local storage ---
/data/
**/data/*.db*
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# --- Backups, dumps & customer/order exports ---
/backups/
**/backups/
eraya-backup-*.json
*.dump
*.bak
*.sql.gz
*.tar
*.tar.gz
*.tgz
*.zip
exports/
*orders*.csv
*customers*.csv
*export*.csv

# --- Dependencies & package managers ---
/node_modules/
/.pnp
.pnp.js
.pnpm-store/

# --- Next.js, build & deployment caches ---
/.next/
/out/
/build/
/dist/
/.turbo/
/.vercel/
/.netlify/

# --- Testing & coverage ---
/coverage/

# --- Logs & temporary files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/tmp/
/temp/

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- OS & IDE files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
